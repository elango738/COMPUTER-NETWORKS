T/F4 7.8 Tf 6 127 TD (    if p == 1:)Tj ET BT/F4 7.8 Tf 6 117.2 TD (        t, c = struct.unpack\("!BB", raw[off:off+2]\))Tj ET BT/F4 7.8 Tf 6 107.4 TD (        print\(f"  ICMP     : type={t} code={c}"\))Tj ET BT/F4 7.8 Tf 6 97.6 TD (    elif p == 6:)Tj ET BT/F4 7.8 Tf 6 87.8 TD (        sp, dp, seq, ack, offs = struct.unpack\("!HHLLB", raw[off:off+13]\))Tj ET BT/F4 7.8 Tf 6 78 TD (        print\(f"  TCP      : {sp} -> {dp}  seq={seq}  ack={ack}"\))Tj ET BT/F4 7.8 Tf 6 68.2 TD (    elif p == 17:)Tj ET BT/F4 7.8 Tf 6 58.4 TD (        sp, dp, ln = struct.unpack\("!HHH", raw[off:off+6]\))Tj ET BT/F4 7.8 Tf 6 48.6 TD (        print\(f"  UDP      : {sp} -> {dp}  length={ln}"\))Tj ET BT/F4 7.8 Tf 6 38.8 TD (    else:)Tj ET BT/F4 7.8 Tf 6 29 TD (        print\(f"  Protocol : {p}"\))Tj ET BT/F4 7.8 Tf 6 19.2 TD (    print\(\))Tj ET BT/F4 7.8 Tf 6 9.4 TD (s.close\(\))Tj ET Q Q

